#!/usr/bin/env python3
"""Hook helper for Agent Resume History adapters."""

import json
import os
import subprocess
import sys


def main():
    marker = os.environ.get("AHR_RUN_FILE")
    if not marker or not os.path.isfile(marker) or os.path.islink(marker):
        return

    try:
        raw = sys.stdin.read()
        if not raw.strip():
            return
        data = json.loads(raw)
    except Exception:
        return

    if not isinstance(data, dict):
        return

    if data.get("agent_id"):
        return

    session_id = data.get("session_id") or data.get("thread_id")
    if not session_id and isinstance(data.get("session"), dict):
        session_id = data["session"].get("id")

    if not session_id or not isinstance(session_id, str):
        return
    session_id = session_id.strip()
    if not session_id:
        return

    ahr_home = os.environ.get("AHR_HOME")
    if ahr_home:
        recorder = os.path.join(ahr_home, "bin", "agent-resume-history-record")
    else:
        sibling = os.path.join(
            os.path.dirname(os.path.abspath(__file__)),
            "agent-resume-history-record",
        )
        if os.path.isfile(sibling):
            recorder = sibling
        else:
            recorder = os.path.expanduser(
                "~/.local/share/agent-resume-history/bin/agent-resume-history-record"
            )

    if not os.path.isfile(recorder):
        return

    subprocess.run([recorder, marker, session_id], check=False)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
